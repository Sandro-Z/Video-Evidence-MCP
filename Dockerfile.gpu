# Optional profile for hosts with NVIDIA Container Toolkit, CUDA 12 and cuDNN 9 support.
FROM ghcr.io/astral-sh/uv:latest AS uv
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    HOME=/tmp \
    HF_HOME=/models/huggingface \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium \
    PATH="/app/.venv/bin:$PATH"
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.12 python3.12-venv chromium ffmpeg ca-certificates fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --no-install-project --python /usr/bin/python3.12
COPY src ./src
RUN uv sync --frozen --no-dev --python /usr/bin/python3.12 \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data/video-evidence-mcp/app/cache /data/video-evidence-mcp/app/tmp /models/huggingface \
    && chown -R app:app /data/video-evidence-mcp /models
USER app
CMD ["video-evidence-worker"]
