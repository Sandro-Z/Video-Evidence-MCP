# Loopback/Secure Tunnel defaults
AUTH_MODE=none
HOST=127.0.0.1
TRUSTED_LOOPBACK_PROXY=false
# Leave empty on normal DNS. Only 198.18.0.0/15 subnets are accepted for a verified transparent proxy.
TRUSTED_DNS_PROXY_CIDR=
PORT=8787
PUBLIC_BASE_URL=
VIDEO_EVIDENCE_DATA_ROOT=/data/video-evidence-mcp
DATA_DIR=/data/video-evidence-mcp/app
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
ANALYSIS_CONCURRENCY=1
MAX_VIDEO_SECONDS=7200
MAX_TEMP_BYTES=4294967296
MAX_CACHE_BYTES=10737418240
CACHE_TTL_DAYS=14
JOB_TIMEOUT_SECONDS=3600
DEFAULT_MAX_FRAMES=24
DEEP_MAX_FRAMES=48
WINDOW_MAX_SECONDS=300
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
OCR_ENABLED=true
PLAYWRIGHT_ENABLED=true
OPENAI_VISION_ENABLED=false
OPENAI_API_KEY=

# Public HTTPS profile only. Use an established external issuer.
DOMAIN=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_REQUIRED_SCOPES=video:read
OIDC_JWKS_URL=
RATE_LIMIT_PER_MINUTE=30
MAX_HTTP_CONCURRENCY=8

# Secure MCP Tunnel secrets belong in /etc/video-evidence-mcp/tunnel.env (0600), not here.
